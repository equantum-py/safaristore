{{ 'section-safari-announcement-bar.css' | asset_url | stylesheet_tag }}
{%- if section.blocks.size > 1 -%}
  <script src="{{ 'safari-slider.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- render 'safari-section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  show_on_desktop: section.settings.show_on_desktop,
  show_on_mobile: section.settings.show_on_mobile
-%}

{%- liquid
  assign links = section.settings.menu.links
  assign has_side = false
  if section.settings.info_text != blank or links.size > 0
    assign has_side = true
  endif
-%}

{%- if section.blocks.size > 0 or has_side -%}
  <div class="safari-announcement color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} safari-announcement--border{% endif %}">
    <div class="safari-announcement__inner page-width section-{{ section.id }}-padding{% if has_side %} safari-announcement__inner--split{% endif %}">
      {%- if section.settings.info_text != blank -%}
        <div class="safari-announcement__info caption">{{ section.settings.info_text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <safari-slider
          class="safari-announcement__messages"
          role="region"
          aria-label="{{ 'sections.header.announcement' | t }}"
          data-autoplay="{{ section.settings.auto_rotate }}"
          data-speed="{{ section.settings.change_slides_speed }}"
        >
          {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
            <button
              type="button"
              class="safari-announcement__arrow safari-announcement__arrow--prev"
              data-slider-prev
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
            </button>
          {%- endif -%}
          <div class="safari-announcement__track" data-slider-track>
            {%- for block in section.blocks -%}
              <div class="safari-announcement__message" data-slider-slide {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="safari-announcement__link link focus-inset">
                      {{- block.settings.text -}}
                    </a>
                  {%- else -%}
                    <p class="safari-announcement__text">{{ block.settings.text }}</p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
            <button
              type="button"
              class="safari-announcement__arrow safari-announcement__arrow--next"
              data-slider-next
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
            </button>
          {%- endif -%}
        </safari-slider>
      {%- endif -%}

      {%- if links.size > 0 -%}
        <nav class="safari-announcement__nav caption" aria-label="{{ section.settings.menu.title | escape }}">
          <ul class="safari-announcement__nav-list list-unstyled" role="list">
            {%- for link in links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="safari-announcement__nav-link link focus-inset"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Safari · Anuncios",
  "class": "safari-announcement-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Mostrar línea inferior",
      "default": false
    },
    {
      "type": "header",
      "content": "Mensajes"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Rotar mensajes automáticamente",
      "default": true,
      "info": "Solo aplica con dos o más mensajes. Se pausa al pasar el cursor o al recibir foco."
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Cambiar cada",
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "header",
      "content": "Información comercial y enlaces"
    },
    {
      "type": "inline_richtext",
      "id": "info_text",
      "label": "Texto informativo",
      "info": "Por ejemplo teléfono u horario. Se muestra a la izquierda en escritorio."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de enlaces",
      "info": "Enlaces a la derecha en escritorio. Se administra en Contenido → Menús."
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "label": "Espacio superior",
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "label": "Espacio inferior",
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Mostrar en escritorio y tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Mostrar en móvil",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Mensaje",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "Mensaje promocional"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Safari · Anuncios",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
