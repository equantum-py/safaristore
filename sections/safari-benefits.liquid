{{ 'section-safari-benefits.css' | asset_url | stylesheet_tag }}

{%- render 'safari-section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  show_on_desktop: section.settings.show_on_desktop,
  show_on_mobile: section.settings.show_on_mobile
-%}

{%- if section.blocks.size > 0 -%}
  <div class="safari-benefits color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} safari-benefits--border{% endif %}">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.title != blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        </div>
      {%- endif -%}

      <ul
        class="safari-benefits__list safari-benefits__list--mobile-{{ section.settings.mobile_layout }} list-unstyled"
        role="list"
        style="--safari-cols-desktop: {{ section.settings.columns_desktop }}; --safari-icon-size: {{ section.settings.icon_size }}px;"
      >
        {%- for block in section.blocks -%}
          <li class="safari-benefits__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="safari-benefit safari-benefit--{{ section.settings.layout }} link link--text focus-inset">
            {%- else -%}
              <div class="safari-benefit safari-benefit--{{ section.settings.layout }}">
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              <div class="safari-benefit__icon">
                {%- assign icon_2x = section.settings.icon_size | times: 2 -%}
                {{
                  block.settings.image
                  | image_url: width: icon_2x
                  | image_tag:
                    class: 'safari-benefit__image',
                    width: section.settings.icon_size,
                    height: section.settings.icon_size,
                    loading: 'lazy',
                    alt: ''
                }}
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="safari-benefit__icon" aria-hidden="true">
                {%- render 'icon-accordion', icon: block.settings.icon -%}
              </div>
            {%- endif -%}

            <div class="safari-benefit__body">
              {%- if block.settings.heading != blank -%}
                <h3 class="safari-benefit__heading {{ section.settings.item_heading_size }}">
                  {{- block.settings.heading | escape -}}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="safari-benefit__text rte caption-large">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Safari · Beneficios",
  "tag": "section",
  "class": "section safari-benefits-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Pequeño"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Distribución"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Disposición en móvil",
      "options": [
        {
          "value": "grid",
          "label": "Cuadrícula de 2 columnas"
        },
        {
          "value": "stack",
          "label": "Uno debajo del otro"
        },
        {
          "value": "scroll",
          "label": "Fila desplazable"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición del ícono",
      "options": [
        {
          "value": "horizontal",
          "label": "A la izquierda del texto"
        },
        {
          "value": "vertical",
          "label": "Arriba del texto"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 64,
      "step": 4,
      "label": "Tamaño del ícono",
      "default": 32,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "item_heading_size",
      "label": "Tamaño del título del beneficio",
      "options": [
        {
          "value": "h5",
          "label": "Pequeño"
        },
        {
          "value": "h4",
          "label": "Mediano"
        },
        {
          "value": "h3",
          "label": "Grande"
        }
      ],
      "default": "h5"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Mostrar líneas superior e inferior",
      "default": false
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Espacio superior",
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Espacio inferior",
      "default": 28,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Mostrar en escritorio y tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Mostrar en móvil",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            {
              "value": "none",
              "label": "Ninguno"
            },
            {
              "value": "truck",
              "label": "Camión (envíos)"
            },
            {
              "value": "box",
              "label": "Caja"
            },
            {
              "value": "return",
              "label": "Devolución"
            },
            {
              "value": "lock",
              "label": "Candado (pago seguro)"
            },
            {
              "value": "check_mark",
              "label": "Tilde (garantía)"
            },
            {
              "value": "chat_bubble",
              "label": "Mensaje (atención)"
            },
            {
              "value": "price_tag",
              "label": "Etiqueta de precio"
            },
            {
              "value": "lightning_bolt",
              "label": "Rayo"
            },
            {
              "value": "stopwatch",
              "label": "Cronómetro"
            },
            {
              "value": "map_pin",
              "label": "Ubicación"
            },
            {
              "value": "star",
              "label": "Estrella"
            },
            {
              "value": "heart",
              "label": "Corazón"
            },
            {
              "value": "recycle",
              "label": "Reciclaje"
            },
            {
              "value": "question_mark",
              "label": "Signo de pregunta"
            },
            {
              "value": "eye",
              "label": "Ojo"
            }
          ],
          "default": "check_mark"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ícono personalizado",
          "info": "Opcional. Reemplaza al ícono elegido. Usar una imagen cuadrada, idealmente SVG o PNG transparente."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Beneficio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Safari · Beneficios",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "lock"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "return"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "chat_bubble"
          }
        }
      ]
    }
  ]
}
{% endschema %}
