{{ 'section-safari-category-grid.css' | asset_url | stylesheet_tag }}

{%- render 'safari-section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  show_on_desktop: section.settings.show_on_desktop,
  show_on_mobile: section.settings.show_on_mobile
-%}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign visible_count = visible_count | plus: 1
    elsif block.settings.title != blank and block.settings.link != blank
      assign visible_count = visible_count | plus: 1
    elsif request.design_mode
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 -%}
  <div class="safari-category-grid color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.title != blank -%}
        <div class="safari-category-grid__header title-wrapper title-wrapper--no-top-margin">
          <h2 class="safari-category-grid__title title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endif -%}

      <ul
        class="safari-category-grid__list safari-category-grid__list--mobile-{{ section.settings.mobile_layout }} list-unstyled"
        role="list"
        style="--safari-cols-desktop: {{ section.settings.columns_desktop }}; --safari-cols-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign item_title = block.settings.title | default: collection.title
            assign item_url = block.settings.link | default: collection.url
            assign item_image = block.settings.image | default: collection.featured_image

            assign is_real = false
            if collection != blank
              assign is_real = true
            elsif block.settings.title != blank and block.settings.link != blank
              assign is_real = true
            endif
          -%}
          {%- if is_real or request.design_mode -%}
            <li class="safari-category-grid__item" {{ block.shopify_attributes }}>
              <a
                {% if item_url != blank %}
                  href="{{ item_url }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="safari-category safari-category--{{ section.settings.text_alignment }} link link--text focus-inset"
              >
                {%- if section.settings.show_image -%}
                  <div class="safari-category__media safari-category__media--{{ section.settings.image_ratio }} safari-category__media--{{ section.settings.image_shape }}{% if item_image == blank %} placeholder{% endif %}">
                    {%- if item_image != blank -%}
                      {%- capture sizes -%}
                        (min-width: 990px) calc({{ settings.page_width }}px / {{ section.settings.columns_desktop }}), (min-width: 750px) calc(100vw / {{ section.settings.columns_desktop }}), calc(100vw / {{ section.settings.columns_mobile }})
                      {%- endcapture -%}
                      {{
                        item_image
                        | image_url: width: 1100
                        | image_tag:
                          class: 'safari-category__image',
                          widths: '165, 250, 360, 535, 750, 1100',
                          sizes: sizes,
                          loading: 'lazy',
                          alt: item_image.alt
                      }}
                    {%- else -%}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg safari-category__image' }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div class="safari-category__info">
                  <h3 class="safari-category__title {{ section.settings.item_heading_size }}">
                    {%- if item_title != blank -%}
                      {{ item_title | escape }}
                    {%- else -%}
                      {{ section.settings.empty_title | escape }}
                    {%- endif -%}
                  </h3>
                  {%- if section.settings.show_count and collection != blank -%}
                    <p class="safari-category__count caption">
                      {{ collection.all_products_count }} {{ section.settings.count_label | escape }}
                    </p>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="safari-category-grid__footer center">
          <a href="{{ section.settings.button_link }}" class="button button--secondary">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Safari · Categorías",
  "tag": "section",
  "class": "section safari-category-grid-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Categorías"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Pequeño"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar imagen",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        {
          "value": "square",
          "label": "Cuadrada"
        },
        {
          "value": "portrait",
          "label": "Vertical"
        },
        {
          "value": "landscape",
          "label": "Horizontal"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Forma de la imagen",
      "options": [
        {
          "value": "default",
          "label": "Rectangular"
        },
        {
          "value": "round",
          "label": "Circular"
        }
      ],
      "default": "default",
      "info": "La forma circular requiere proporción cuadrada."
    },
    {
      "type": "select",
      "id": "item_heading_size",
      "label": "Tamaño del nombre",
      "options": [
        {
          "value": "h5",
          "label": "Pequeño"
        },
        {
          "value": "h4",
          "label": "Mediano"
        },
        {
          "value": "h3",
          "label": "Grande"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Mostrar cantidad de productos",
      "default": false
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Texto junto a la cantidad",
      "default": "productos"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Nombre provisional en el editor",
      "default": "Elegí una colección",
      "info": "Solo se ve en el editor mientras el bloque no tiene colección."
    },
    {
      "type": "header",
      "content": "Distribución"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en móvil",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Disposición en móvil",
      "options": [
        {
          "value": "scroll",
          "label": "Fila desplazable"
        },
        {
          "value": "grid",
          "label": "Cuadrícula"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Espacio superior",
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Espacio inferior",
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Mostrar en escritorio y tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Mostrar en móvil",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Opcional. Reemplaza la imagen de la colección."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "info": "Opcional. Reemplaza el nombre de la colección."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace",
          "info": "Opcional. Reemplaza el enlace de la colección. Sin colección, el bloque solo se publica si tiene nombre y enlace."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Safari · Categorías",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
