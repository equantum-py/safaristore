<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'section-safari-category-menu.css' | asset_url | stylesheet_tag }}

{%- render 'safari-section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  show_on_desktop: section.settings.show_on_desktop,
  show_on_mobile: section.settings.show_on_mobile
-%}

{%- assign links = section.settings.menu.links -%}

{%- if links.size > 0 -%}
  <div class="safari-category-menu color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} safari-category-menu--border{% endif %}">
    <nav
      class="safari-category-menu__nav page-width section-{{ section.id }}-padding safari-category-menu__nav--{{ section.settings.alignment }}"
      aria-label="{{ section.settings.menu.title | escape }}"
    >
      {%- comment -%} Escritorio: menú con desplegables de hasta tres niveles {%- endcomment -%}
      <ul class="safari-category-menu__list safari-category-menu__list--desktop list-menu list-menu--inline" role="list">
        {%- for link in links -%}
          <li>
            {%- if link.links != blank -%}
              <header-menu>
                <details id="Details-SafariMenu-{{ section.id }}-{{ forloop.index }}">
                  <summary
                    id="SafariMenu-{{ section.id }}-{{ link.handle }}"
                    class="header__menu-item list-menu__item link focus-inset"
                  >
                    <span
                      {%- if link.child_active %}
                        class="header__active-menu-item"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </span>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <ul
                    id="SafariMenu-List-{{ section.id }}-{{ forloop.index }}"
                    class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                    role="list"
                    tabindex="-1"
                  >
                    {%- if section.settings.show_parent_link -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if link.current %} list-menu__item--active{% endif %}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ section.settings.parent_link_label | escape }} {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endif -%}
                    {%- for childlink in link.links -%}
                      <li>
                        {%- if childlink.links == blank -%}
                          <a
                            href="{{ childlink.url }}"
                            class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                            {% if childlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ childlink.title | escape }}
                          </a>
                        {%- else -%}
                          <details id="Details-SafariSubMenu-{{ section.id }}-{{ link.handle }}-{{ childlink.handle }}">
                            <summary class="header__menu-item link link--text list-menu__item focus-inset caption-large">
                              <span>{{ childlink.title | escape }}</span>
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </summary>
                            <ul class="header__submenu list-menu motion-reduce" role="list">
                              {%- for grandchildlink in childlink.links -%}
                                <li>
                                  <a
                                    href="{{ grandchildlink.url }}"
                                    class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                    {% if grandchildlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ grandchildlink.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              </header-menu>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="header__menu-item list-menu__item link link--text focus-inset"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                <span
                  {%- if link.current %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%}
        Móvil y tablet: fila desplazable con las categorías principales.
        Las subcategorías se navegan desde el menú lateral del encabezado.
      {%- endcomment -%}
      {%- if section.settings.mobile_behavior == 'scroll' -%}
        <ul class="safari-category-menu__list safari-category-menu__list--mobile list-unstyled" role="list">
          {%- for link in links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="safari-category-menu__chip link link--text focus-inset{% if link.active %} safari-category-menu__chip--active{% endif %}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>
  </div>
{%- elsif request.design_mode -%}
  <div class="safari-category-menu color-{{ section.settings.color_scheme }} gradient">
    <p class="safari-category-menu__empty page-width caption">{{ section.settings.empty_message | escape }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Safari · Menú categorías",
  "class": "safari-category-menu-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de categorías",
      "info": "Admite hasta tres niveles. Se administra en Contenido → Menús; cada elemento es un enlace real a una colección, producto o página."
    },
    {
      "type": "checkbox",
      "id": "show_parent_link",
      "label": "Agregar enlace a la categoría principal dentro del desplegable",
      "default": true,
      "info": "En un menú con subcategorías, el título solo abre el desplegable. Esta opción suma un enlace para ver la categoría completa."
    },
    {
      "type": "text",
      "id": "parent_link_label",
      "label": "Texto del enlace a la categoría principal",
      "default": "Ver todo"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Aviso en el editor cuando no hay menú",
      "default": "Elegí un menú de categorías en la configuración de esta sección.",
      "info": "Solo se ve en el editor, nunca en la tienda."
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "menu_color_scheme",
      "label": "Esquema de color de los desplegables",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación en escritorio",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Mostrar línea inferior",
      "default": true
    },
    {
      "type": "header",
      "content": "Móvil y tablet"
    },
    {
      "type": "select",
      "id": "mobile_behavior",
      "label": "Comportamiento",
      "options": [
        {
          "value": "scroll",
          "label": "Fila desplazable de categorías"
        },
        {
          "value": "hide",
          "label": "Ocultar (usar solo el menú lateral)"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 24,
      "step": 2,
      "label": "Espacio superior",
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 24,
      "step": 2,
      "label": "Espacio inferior",
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Mostrar en escritorio y tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Mostrar en móvil",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Safari · Menú categorías"
    }
  ]
}
{% endschema %}
