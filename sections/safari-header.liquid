<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
{{ 'section-safari-header.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .safari-header__inner {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .safari-header__logo-image {
    width: {{ section.settings.logo_width_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    .safari-header__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .safari-header__logo-image {
      width: {{ section.settings.logo_width }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign header_tag = 'div'
  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif

  assign logo = section.settings.logo | default: settings.logo
  assign search_input_id = 'SafariSearch-' | append: section.id
-%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper safari-header color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  <header class="safari-header__inner page-width{% if section.settings.show_search %} safari-header__inner--has-search{% endif %}{% if section.settings.menu != blank %} safari-header__inner--has-menu{% endif %}">
    {%- if section.settings.menu != blank -%}
      <div class="safari-header__drawer">
        {%- render 'header-drawer',
          show_country_selector: false,
          show_language_selector: false,
          show_social_links: section.settings.show_social_in_drawer
        -%}
      </div>
    {%- endif -%}

    <div class="safari-header__brand">
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if logo != blank -%}
          {%- liquid
            assign logo_alt = logo.alt | default: shop.name | escape
            assign logo_height = section.settings.logo_width | divided_by: logo.aspect_ratio | round
            assign logo_2x = section.settings.logo_width | times: 2
          -%}
          {% capture logo_widths %}{{ section.settings.logo_width }}, {{ section.settings.logo_width | times: 1.5 | round }}, {{ logo_2x }}{% endcapture %}
          {% capture logo_sizes %}(max-width: 989px) {{ section.settings.logo_width_mobile }}px, {{ section.settings.logo_width }}px{% endcapture %}
          {{
            logo
            | image_url: width: 600
            | image_tag:
              class: 'safari-header__logo-image motion-reduce',
              widths: logo_widths,
              width: section.settings.logo_width,
              height: logo_height,
              alt: logo_alt,
              sizes: logo_sizes,
              preload: true
          }}
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    </div>

    {%- if section.settings.show_inline_menu and section.settings.menu != blank -%}
      <div class="safari-header__menu">
        {%- render 'header-dropdown-menu' -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_search -%}
      <div class="safari-header__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="safari-header__search-form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="safari-header__search-form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search">
          <div class="field">
            <input
              class="search__input field__input"
              id="{{ search_input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <label class="field__label" for="{{ search_input_id }}">{{ 'general.search.search' | t }}</label>
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">{{ 'icon-reset.svg' | inline_asset_content }}</span>
            </button>
            <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
              <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="safari-header__icons">
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <shopify-account
          menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
          class="header__icon header__icon--account link focus-inset"
        >
          <span slot="signed-out-avatar" class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          <span slot="signed-out-avatar" class="visually-hidden">{{ 'customer.log_in' | t }}</span>
        </shopify-account>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

{% schema %}
{
  "name": "Safari · Header",
  "class": "section-header",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Reemplaza al encabezado de Dawn: no deben estar los dos activos a la vez, porque comparten el ícono del carrito y el menú lateral."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Si queda vacío se usa el logo de Configuración del tema y, si tampoco hay, el nombre de la tienda."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "label": "Ancho del logo en escritorio",
      "default": 140,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 40,
      "max": 200,
      "step": 10,
      "label": "Ancho del logo en móvil",
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Navegación"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menú",
      "info": "Alimenta el menú lateral en móvil y tablet."
    },
    {
      "type": "checkbox",
      "id": "show_inline_menu",
      "label": "Mostrar menú desplegable en escritorio",
      "default": false,
      "info": "Desactivar si se usa la sección Safari · Menú categorías."
    },
    {
      "type": "color_scheme",
      "id": "menu_color_scheme",
      "label": "Esquema de color del menú",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_social_in_drawer",
      "label": "Mostrar redes sociales en el menú lateral",
      "default": true
    },
    {
      "type": "header",
      "content": "Buscador, cuenta y carrito"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar buscador",
      "default": true,
      "info": "Busca en el catálogo de Shopify. Las sugerencias dependen de Configuración del tema → Comportamiento de búsqueda."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Mostrar acceso a la cuenta",
      "default": true,
      "info": "Requiere cuentas de cliente activas en la tienda."
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "label": "Mostrar línea inferior",
      "default": true
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "label": "Encabezado fijo",
      "options": [
        {
          "value": "none",
          "label": "No"
        },
        {
          "value": "on-scroll-up",
          "label": "Al desplazarse hacia arriba"
        },
        {
          "value": "always",
          "label": "Siempre"
        }
      ],
      "default": "on-scroll-up"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "label": "Espacio superior",
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "label": "Espacio inferior",
      "default": 16,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Safari · Header"
    }
  ]
}
{% endschema %}
